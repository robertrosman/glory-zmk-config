if SHIELD_GLORY_LEFT

config ZMK_KEYBOARD_NAME
    default "Glory"

# The left half is the central (connects to the host); the right half is a
# peripheral. Required so the PMW3610 on the right can forward input over the
# split link to the listener on the central.
config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_GLORY_LEFT || SHIELD_GLORY_RIGHT || SHIELD_GLORY_LEFT_PERIPHERAL

config ZMK_SPLIT
    default y

endif
